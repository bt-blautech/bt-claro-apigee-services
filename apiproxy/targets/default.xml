<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="default">
    <Description>Backend mock de clientes (Cloud Run), resuelto por Target Server distinto en DEV y QA</Description>
    <FaultRules>
        <FaultRule name="backend-5xx">
            <Condition>(fault.name = "ErrorResponseCode") and (response.status.code >= 500)</Condition>
            <Step>
                <Name>RF-BackendError</Name>
            </Step>
        </FaultRule>
    </FaultRules>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>AM-SetBackendAuth</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows/>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <HTTPTargetConnection>
        <LoadBalancer>
            <!-- Mismo nombre en todos los ambientes; host/puerto/TLS cambian por ambiente (Terraform) -->
            <Server name="poc-customer-backend"/>
        </LoadBalancer>
        <Path>/poc-customers/v0</Path>
    </HTTPTargetConnection>
</TargetEndpoint>
