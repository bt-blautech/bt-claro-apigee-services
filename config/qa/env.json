{
  "environment": "qa",
  "targetServer": {
    "name": "poc-customer-backend",
    "hostFrom": "BACKEND_HOST",
    "port": 443,
    "tls": true,
    "truststoreRef": "ref-ts-backend-qa"
  },
  "kvm": {
    "name": "poc-customer-config",
    "entries": {
      "quota_limit": "500",
      "env_label": "QA"
    },
    "vaultEntries": {
      "api_secret": "api-secret"
    }
  },
  "app": {
    "name": "poc-app-qa"
  },
  "smoke": {
    "path": "/v1/poc-customer",
    "maxLatencyMs": 500,
    "expectedQuota": 500
  }
}
