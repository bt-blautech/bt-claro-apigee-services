{
  "environment": "prod",
  "targetServer": {
    "name": "poc-customer-backend",
    "hostFrom": "BACKEND_HOST",
    "port": 443,
    "tls": true,
    "truststoreRef": "ref-ts-backend-prod"
  },
  "kvm": {
    "name": "poc-customer-config",
    "entries": {
      "quota_limit": "1000",
      "env_label": "PROD"
    },
    "vaultEntries": {
      "api_secret": "api-secret"
    }
  },
  "app": {
    "name": "poc-app-prod"
  },
  "smoke": {
    "path": "/v1/poc-customer",
    "maxLatencyMs": 500,
    "expectedQuota": 1000
  }
}
